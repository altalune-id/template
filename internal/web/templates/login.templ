package templates

import "altalune.id/template/internal/web"

type LoginView struct {
	Error      string
	Message    string
	ReturnTo   string
	LastEmail  string
	AdminForce bool
	LocalAuth  bool
}

templ LoginPage(d web.LayoutData, v LoginView) {
	<section class="mx-auto max-w-sm">
		<h1 class="text-2xl font-semibold text-center">{ d.Tr("login.title") }</h1>
		if v.Message != "" {
			<div class="mt-4 p-3 rounded bg-emerald-50 text-emerald-800 text-sm border border-emerald-200 dark:bg-emerald-950/40 dark:text-emerald-200 dark:border-emerald-900/50">{ v.Message }</div>
		}
		if v.Error != "" {
			<div class="mt-4 p-3 rounded bg-red-100 text-red-800 text-sm dark:bg-red-950/50 dark:text-red-200">{ v.Error }</div>
		}
		if d.Caps.ExternalIdentity && !v.AdminForce {
			if v.LastEmail != "" {
				<a
					class="btn-sso mt-6"
					title={ d.Tr("login.continue_as") + " " + v.LastEmail }
					href={ templ.SafeURL(d.Href("/login/oidc?return_to=" + v.ReturnTo)) }
				>
					<img class="btn-sso__logo" src={ d.OIDCButtonLogoURL() } alt="" aria-hidden="true" width="24" height="24"/>
					<span class="btn-sso__label">{ d.Tr("login.continue_as") } { v.LastEmail }</span>
					<span class="btn-sso__chev" aria-hidden="true">→</span>
				</a>
				<p class="mt-3 text-center text-sm text-muted-foreground">
					<a class="hover:underline" href={ templ.SafeURL(d.Href("/login/oidc?switch=1&return_to=" + v.ReturnTo)) }>{ d.Tr("login.switch_account") }</a>
				</p>
			} else {
				<a
					class="btn-sso mt-6"
					href={ templ.SafeURL(d.Href("/login/oidc?return_to=" + v.ReturnTo)) }
				>
					<img class="btn-sso__logo" src={ d.OIDCButtonLogoURL() } alt="" aria-hidden="true" width="24" height="24"/>
					<span class="btn-sso__label">{ d.OIDCButtonLabel(d.Tr("login.oidc_button")) }</span>
					<span class="btn-sso__chev" aria-hidden="true">→</span>
				</a>
			}
			if v.LocalAuth {
				<div class="mt-6 text-center">
					<a href={ templ.SafeURL(d.Href("/admin-login")) } class="text-sm text-muted-foreground hover:underline">
						{ d.Tr("login.admin_link") }
					</a>
				</div>
			}
		}
		if v.LocalAuth && (v.AdminForce || !d.Caps.ExternalIdentity) {
			<form method="post" action={ templ.SafeURL(d.Href("/login")) } class="mt-6 space-y-4">
				if v.ReturnTo != "" {
					<input type="hidden" name="return_to" value={ v.ReturnTo }/>
				}
				if v.AdminForce {
					<input type="hidden" name="admin" value="1"/>
				}
				<div>
					<label for="email" class="block text-sm font-medium">{ d.Tr("login.email") }</label>
					<input
						id="email"
						name="email"
						type="email"
						required
						autocomplete="username"
						class="mt-1.5 block w-full rounded-md border border-border bg-card px-3 py-2 text-sm text-foreground placeholder:text-muted-foreground/70 shadow-sm focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-1"
					/>
				</div>
				<div>
					<label for="password" class="block text-sm font-medium">{ d.Tr("login.password") }</label>
					<input
						id="password"
						name="password"
						type="password"
						required
						autocomplete="current-password"
						class="mt-1.5 block w-full rounded-md border border-border bg-card px-3 py-2 text-sm text-foreground placeholder:text-muted-foreground/70 shadow-sm focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-1"
					/>
				</div>
				<button
					type="submit"
					class="w-full rounded-md bg-primary px-4 py-2.5 text-sm font-medium text-primary-foreground shadow-sm hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
				>
					{ d.Tr("login.submit") }
				</button>
			</form>
		}
		if !v.LocalAuth && !d.Caps.ExternalIdentity {
			<p class="mt-6 text-center text-sm text-muted-foreground">
				{ d.Tr("login.no_method") }
			</p>
		}
	</section>
}

templ LoginLayout(d web.LayoutData, v LoginView) {
	@Layout(web.WithContent(d, LoginPage(d, v)))
}
