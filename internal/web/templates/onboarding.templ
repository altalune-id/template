package templates

import "altalune.id/template/internal/web"

type OnboardingView struct {
	Email       string
	DisplayName string
	ReturnTo    string
	Error       string
}

templ OnboardingPage(d web.LayoutData, v OnboardingView) {
	<section class="mx-auto max-w-md">
		<h1 class="text-2xl font-semibold">{ d.Tr("onboarding.title") }</h1>
		<p class="mt-2 text-muted-foreground">{ d.Tr("onboarding.subtitle_prefix") } { v.Email }{ d.Tr("onboarding.subtitle_suffix") }</p>
		if v.Error != "" {
			<div class="mt-4 p-3 rounded bg-red-100 text-red-800 text-sm dark:bg-red-950/50 dark:text-red-200">{ v.Error }</div>
		}
		<form method="post" action={ templ.SafeURL(d.Href("/onboarding")) } class="mt-6 space-y-4">
			if v.ReturnTo != "" {
				<input type="hidden" name="return_to" value={ v.ReturnTo }/>
			}
			<div>
				<label for="display_name" class="block text-sm font-medium">{ d.Tr("onboarding.display_name") }</label>
				<input
					id="display_name"
					name="display_name"
					type="text"
					required
					value={ v.DisplayName }
					class="mt-1.5 block w-full rounded-md border border-border bg-card px-3 py-2 text-sm text-foreground placeholder:text-muted-foreground/70 shadow-sm focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-1"
				/>
			</div>
			<label class="flex items-start gap-2 text-sm">
				<input type="checkbox" name="accept_terms" value="1" required class="mt-1"/>
				<span>{ d.Tr("onboarding.accept") }</span>
			</label>
			<button type="submit" class="w-full rounded bg-primary px-4 py-2 text-primary-foreground hover:bg-primary/90">
				{ d.Tr("onboarding.submit") }
			</button>
		</form>
	</section>
}

templ OnboardingLayout(d web.LayoutData, v OnboardingView) {
	@Layout(web.WithContent(d, OnboardingPage(d, v)))
}
