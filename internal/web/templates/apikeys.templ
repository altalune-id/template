package templates

import (
	"altalune.id/template/internal/web"
	"altalune.id/template/internal/web/icons"
)

// API key form error kinds the apikeys screen renders as a banner.
const (
	APIKeyErrorScope         = "scope"
	APIKeyErrorNotFound      = "not_found"
	APIKeyErrorInvalidExpiry = "invalid_expiry"
	APIKeyErrorFailed        = "failed"
)

type APIKeyScopeOption struct {
	Value    string
	LabelKey string
}

type APIKeyRow struct {
	ID             string
	Name           string
	ScopeLabelKeys []string
	CreatedAt      string
	HasExpiry      bool
	ExpiresAt      string
	HasLastUsed    bool
	LastUsedAt     string
	Revoked        bool
	RevokedAt      string
}

// APIKeyMinted carries the plaintext secret exactly once, right after Mint returns it.
// SECURITY: this type is only ever built from apikey.Service.Mint's direct return value and only
// ever rendered into the one response that follows a mint — never into APIKeyRow, never persisted.
type APIKeyMinted struct {
	Name      string
	Plaintext string
}

type APIKeysView struct {
	OrgSlug     string
	ProjectSlug string
	ProjectName string
	Items       []APIKeyRow
	Scopes      []APIKeyScopeOption
	Minted      *APIKeyMinted
	ErrorKind   string
	ErrorCode   string
}

templ apikeyBanner(d web.LayoutData, kind, code string) {
	if kind == APIKeyErrorScope {
		@ErrorBanner(d, d.Tr("apikey.error_scope"), code)
	} else if kind == APIKeyErrorNotFound {
		@ErrorBanner(d, d.Tr("apikey.error_not_found"), code)
	} else if kind == APIKeyErrorInvalidExpiry {
		@ErrorBanner(d, d.Tr("apikey.error_invalid_expiry"), code)
	} else if kind == APIKeyErrorFailed {
		@ErrorBanner(d, d.Tr("apikey.error_failed"), code)
	}
}

// apikeyMintedBanner shows the one-time plaintext. It is reachable only through APIKeysView.Minted,
// which the handler sets solely on the response that immediately follows a successful mint.
templ apikeyMintedBanner(d web.LayoutData, m *APIKeyMinted) {
	<div class="mt-4 rounded-md border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900 dark:border-amber-800 dark:bg-amber-950/40 dark:text-amber-100">
		<p class="font-semibold">{ d.Tr("apikey.minted_heading") }</p>
		<p class="mt-1 text-xs">{ d.Tr("apikey.minted_warning") }</p>
		<code class="mt-2 block select-all break-all rounded border border-amber-300/70 bg-amber-100/60 px-3 py-2 font-mono text-sm dark:border-amber-800 dark:bg-amber-900/40">{ m.Plaintext }</code>
	</div>
}

templ apikeyRowItem(d web.LayoutData, v APIKeysView, k APIKeyRow) {
	<li class="flex flex-wrap items-center gap-3 px-4 py-3">
		<div class="min-w-0 flex-1">
			<p class="truncate text-sm font-medium text-foreground">{ k.Name }</p>
			if len(k.ScopeLabelKeys) > 0 {
				<p class="mt-1 flex flex-wrap gap-1">
					for _, labelKey := range k.ScopeLabelKeys {
						<span class="rounded-full border border-border px-2 py-0.5 text-[11px] text-muted-foreground">{ d.Tr(labelKey) }</span>
					}
				</p>
			}
			<p class="mt-1.5 flex flex-wrap gap-x-1.5 text-xs text-muted-foreground">
				<span>{ d.Tr("apikey.created_label") }: { k.CreatedAt }</span>
				<span>·</span>
				<span>
					{ d.Tr("apikey.expires_col_label") }:
					if k.HasExpiry {
						{ k.ExpiresAt }
					} else {
						{ d.Tr("apikey.never") }
					}
				</span>
				<span>·</span>
				<span>
					{ d.Tr("apikey.last_used_label") }:
					if k.HasLastUsed {
						{ k.LastUsedAt }
					} else {
						{ d.Tr("apikey.never") }
					}
				</span>
			</p>
		</div>
		if k.Revoked {
			<span class="shrink-0 rounded-full bg-red-100 px-2 py-0.5 text-xs font-medium text-red-800 dark:bg-red-950/60 dark:text-red-200">
				{ d.Tr("apikey.revoked_badge") }: { k.RevokedAt }
			</span>
		} else {
			<form
				method="post"
				action={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, "/apikeys/"+k.ID+"/revoke")) }
				hx-post={ d.ProjectPath(v.ProjectSlug, "/apikeys/"+k.ID+"/revoke") }
				hx-nonce={ d.Nonce }
				hx-target="#apikey-list"
				hx-swap="outerHTML"
				hx-disable="find button, find input"
				hx-status:4xx="target:#hx-error swap:innerHTML"
				hx-status:5xx="target:#hx-error swap:innerHTML"
				class="inline"
			>
				<button
					type="submit"
					aria-label={ d.Tr("apikey.revoke") + ": " + k.Name }
					class="shrink-0 rounded p-1.5 text-muted-foreground/70 hover:bg-red-50 hover:text-red-600 dark:hover:bg-red-950/40 dark:hover:text-red-400"
				>
					@icons.Icon("trash-2", "h-4 w-4")
				</button>
			</form>
		}
	</li>
}

// APIKeyList is the HTMX-swappable list section — the mint and revoke forms target #apikey-list.
templ APIKeyList(d web.LayoutData, v APIKeysView) {
	<div id="apikey-list" class="mt-6">
		if v.Minted != nil {
			@apikeyMintedBanner(d, v.Minted)
		}
		@apikeyBanner(d, v.ErrorKind, v.ErrorCode)
		<ul class="mt-4 divide-y divide-border/50 overflow-hidden rounded-lg border border-border bg-card shadow-sm">
			if len(v.Items) == 0 {
				<li class="px-4 py-8 text-center text-sm text-muted-foreground">{ d.Tr("apikey.empty") }</li>
			}
			for _, k := range v.Items {
				@apikeyRowItem(d, v, k)
			}
		</ul>
	</div>
}

templ APIKeysPage(d web.LayoutData, v APIKeysView) {
	<section>
		<header class="border-b border-border pb-4">
			<h1 class="text-2xl font-semibold text-foreground">{ d.Tr("apikey.title") }</h1>
			<p class="mt-1 text-sm text-muted-foreground">{ d.Tr("apikey.subtitle") }</p>
		</header>
		<form
			method="post"
			action={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, "/apikeys")) }
			hx-post={ d.ProjectPath(v.ProjectSlug, "/apikeys") }
			hx-nonce={ d.Nonce }
			hx-target="#apikey-list"
			hx-swap="outerHTML"
			hx-disable="find button, find input"
			hx-status:4xx="target:#hx-error swap:innerHTML"
			hx-status:5xx="target:#hx-error swap:innerHTML"
			data-reset-on-success
			class="mt-6 space-y-4 rounded-lg border border-border bg-card p-5 shadow-sm"
		>
			<div>
				<h2 class="text-sm font-semibold text-foreground">{ d.Tr("apikey.form_heading") }</h2>
				<p class="mt-1 text-xs text-muted-foreground">{ d.Tr("apikey.form_subtitle") }</p>
			</div>
			<div>
				<label class="block text-sm font-medium text-foreground/90" for="apikey-name">{ d.Tr("apikey.name_label") }</label>
				<input
					id="apikey-name"
					name="name"
					type="text"
					required
					class="mt-1.5 block w-full max-w-sm rounded-md border border-border bg-card px-3 py-2 text-sm text-foreground placeholder:text-muted-foreground/70 shadow-sm focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-1"
				/>
			</div>
			<div>
				<p class="block text-sm font-medium text-foreground/90">{ d.Tr("apikey.scopes_label") }</p>
				<div class="mt-1.5 flex flex-wrap gap-2">
					for _, opt := range v.Scopes {
						<label class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-border px-3 py-1 text-sm text-foreground/90 hover:bg-muted has-[:checked]:border-primary has-[:checked]:bg-primary/10">
							<input type="checkbox" name="scopes" value={ opt.Value } class="h-3.5 w-3.5 rounded border-border"/>
							<span>{ d.Tr(opt.LabelKey) }</span>
						</label>
					}
				</div>
			</div>
			<div>
				<label class="block text-sm font-medium text-foreground/90" for="apikey-expires">{ d.Tr("apikey.expires_label") }</label>
				<input
					id="apikey-expires"
					name="expires_at"
					type="date"
					class="mt-1.5 block w-full max-w-xs rounded-md border border-border bg-card px-3 py-2 text-sm text-foreground shadow-sm focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-1"
				/>
			</div>
			<button type="submit" class="inline-flex items-center gap-2 rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow-sm hover:bg-primary/90">
				@icons.Icon("plus", "h-4 w-4")
				<span>{ d.Tr("apikey.mint") }</span>
			</button>
		</form>
		@APIKeyList(d, v)
	</section>
}

templ APIKeysLayout(d web.LayoutData, v APIKeysView) {
	@Layout(web.WithContent(d, APIKeysPage(d, v)))
}
