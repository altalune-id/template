package templates

import (
	"altalune.id/template/internal/web"
	"strconv"
)

type ErrorView struct {
	Status    int
	Title     string
	Message   string
	RequestID string
	Code string
}

templ ErrorPage(d web.LayoutData, v ErrorView) {
	<section class="mx-auto max-w-md text-center py-12">
		<p class="text-sm uppercase tracking-widest text-muted-foreground">
			if v.Status > 0 {
				{ d.Tr("error.label") + " " + strconv.Itoa(v.Status) }
			} else {
				{ d.Tr("error.label") }
			}
		</p>
		<h1 class="mt-2 text-2xl font-semibold">{ v.Title }</h1>
		if v.Message != "" {
			<p class="mt-2 text-muted-foreground">{ v.Message }</p>
		}
		<a href={ templ.SafeURL(d.Href("/")) } class="mt-6 inline-block text-primary hover:underline">{ d.Tr("error.return_home") }</a>
		if v.Code != "" || v.RequestID != "" {
			<p class="mt-6 space-x-3 text-xs text-muted-foreground">
				if v.Code != "" {
					<span>
						{ d.Tr("error.code") }
						<code class="select-all font-mono">{ v.Code }</code>
					</span>
				}
				if v.RequestID != "" {
					<span>
						{ d.Tr("error.request_id") }
						<code class="select-all font-mono">{ v.RequestID }</code>
					</span>
				}
			</p>
		}
	</section>
}

// ErrorFragment is the compact banner htmx requests get instead of a full page.
templ ErrorFragment(d web.LayoutData, v ErrorView) {
	<div class="alt-error rounded-md border border-red-300 bg-red-50 p-3 text-sm text-red-800 dark:border-red-900 dark:bg-red-950/40 dark:text-red-300" role="alert" data-status={ strconv.Itoa(v.Status) }>
		<strong class="font-medium">{ v.Title }</strong>
		if v.Message != "" {
			<span class="ml-1">{ v.Message }</span>
		}
		if v.Code != "" || v.RequestID != "" {
			<p class="mt-1 space-x-3 text-xs opacity-80">
				if v.Code != "" {
					<span>
						{ d.Tr("error.code") }
						<code class="select-all font-mono">{ v.Code }</code>
					</span>
				}
				if v.RequestID != "" {
					<span>
						{ d.Tr("error.request_id") }
						<code class="select-all font-mono">{ v.RequestID }</code>
					</span>
				}
			</p>
		}
	</div>
}

templ ErrorLayout(d web.LayoutData, v ErrorView) {
	@Layout(web.WithContent(d, ErrorPage(d, v)))
}
