package templates

import (
	"strconv"

	"altalune.id/template/internal/web"
	"altalune.id/template/internal/web/icons"
)

// WebhookSecretMask is what the detail page shows in place of a signing secret after its one-time reveal.
const WebhookSecretMask = "whsec_••••"

type WebhookNotice struct {
	Key   string
	Count int
}

type WebhookDeliveryRow struct {
	ID             string
	EventLabelKey  string
	Status         string
	StatusLabelKey string
	Attempt        int
	LastError      string
	CreatedAt      string
	NextRetry      string
	Failed         bool
	Error          WebhookError
}

type WebhookAttemptRow struct {
	Attempt    int
	StatusCode int
	Error      string
	Duration   string
	CreatedAt  string
	Response   WebhookResponseView
}

type WebhookResponseView struct {
	Body      string
	Pretty    string
	Truncated bool
	LimitKiB  int
	Headers   []WebhookHeaderRow
}

type WebhookHeaderRow struct {
	Name  string
	Value string
}

type WebhookPayloadView struct {
	Body    string
	Headers []WebhookHeaderRow
}

type WebhookDeliveriesView struct {
	ProjectSlug string
	EndpointID  string
	Active      bool
	MaxAttempts int
	Items       []WebhookDeliveryRow
	FailedCount int
	Notice      WebhookNotice
	Error          WebhookError
}

// WebhookDetailView carries Secret only on the response right after Create or Rotate.
// SECURITY: Secret is set solely from the service's direct return value and never persisted or logged.
type WebhookDetailView struct {
	ProjectSlug string
	Endpoint    WebhookRow
	Secret      string
	Form        WebhookFormView
	Deliveries  WebhookDeliveriesView
	Guide       WebhookGuideView
}

func webhookPath(d web.LayoutData, projectSlug, endpointID, suffix string) string {
	return d.ProjectPath(projectSlug, "/webhooks/"+endpointID+suffix)
}

templ webhookSecretBanner(d web.LayoutData, secret string) {
	<div data-webhook-secret class="mt-4 rounded-md border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900 dark:border-amber-800 dark:bg-amber-950/40 dark:text-amber-100">
		<p class="font-semibold">{ d.Tr("webhooks.secret_heading") }</p>
		<p class="mt-1 text-xs">{ d.Tr("webhooks.secret_warning") }</p>
		<div class="mt-2 break-all rounded border border-amber-300/70 bg-amber-100/60 px-3 py-2 dark:border-amber-800 dark:bg-amber-900/40">
			@copyValue(d, secret)
		</div>
		@copyScript(d.Nonce)
	</div>
}

templ webhookStatusBadge(d web.LayoutData, row WebhookDeliveryRow) {
	if row.StatusLabelKey != "" {
		if row.Status == "delivered" {
			<span class="rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-medium text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-200">{ d.Tr(row.StatusLabelKey) }</span>
		} else if row.Status == "failed" {
			<span class="rounded-full bg-red-100 px-2 py-0.5 text-xs font-medium text-red-800 dark:bg-red-950/60 dark:text-red-200">{ d.Tr(row.StatusLabelKey) }</span>
		} else {
			<span class="rounded-full bg-muted px-2 py-0.5 text-xs font-medium text-muted-foreground">{ d.Tr(row.StatusLabelKey) }</span>
		}
	}
}

// WebhookDeliveryItem is one delivery row; Retry swaps it in place.
templ WebhookDeliveryItem(d web.LayoutData, v WebhookDeliveriesView, row WebhookDeliveryRow) {
	<li id={ "delivery-" + row.ID } class="px-4 py-3">
		<div class="flex flex-wrap items-center gap-3">
			<div class="min-w-0 flex-1">
				<p class="flex flex-wrap items-center gap-2 text-sm">
					if row.EventLabelKey != "" {
						<span class="font-medium text-foreground">{ d.Tr(row.EventLabelKey) }</span>
					}
					@webhookStatusBadge(d, row)
					if row.Status != "" && row.Attempt == 0 {
						<span class="text-xs text-muted-foreground">{ d.Tr("webhooks.not_attempted") }</span>
					} else if row.Status != "" {
						<span class="text-xs text-muted-foreground">{ d.Tr("webhooks.attempt_label") } { webhookAttemptLabel(row.Attempt, v.MaxAttempts) }</span>
					}
				</p>
				<p class="mt-1 flex flex-wrap gap-x-1.5 text-xs text-muted-foreground">
					<code class="font-mono">{ row.ID }</code>
					if row.CreatedAt != "" {
						<span>·</span>
						<span>{ d.Tr("webhooks.created_label") }: { row.CreatedAt }</span>
					}
					if row.NextRetry != "" {
						<span>·</span>
						<span>{ d.Tr("webhooks.next_retry_label") }: { row.NextRetry }</span>
					}
				</p>
				if row.LastError != "" {
					<p class="mt-1 break-all font-mono text-xs text-red-700 dark:text-red-300">{ row.LastError }</p>
				}
			</div>
			<button
				type="button"
				hx-get={ webhookPath(d, v.ProjectSlug, v.EndpointID, "/deliveries/"+row.ID) }
				hx-nonce={ d.Nonce }
				hx-target={ "#delivery-detail-" + row.ID }
				hx-swap="innerHTML"
				hx-status:4xx="target:#hx-error swap:innerHTML"
				hx-status:5xx="target:#hx-error swap:innerHTML"
				class="shrink-0 rounded-md border border-border px-2.5 py-1 text-xs text-foreground/90 hover:bg-muted"
			>{ d.Tr("webhooks.show_details") }</button>
			if row.Failed {
				<form
					method="post"
					action={ templ.SafeURL(webhookPath(d, v.ProjectSlug, v.EndpointID, "/deliveries/"+row.ID+"/retry")) }
					hx-post={ webhookPath(d, v.ProjectSlug, v.EndpointID, "/deliveries/"+row.ID+"/retry") }
					hx-nonce={ d.Nonce }
					hx-target={ "#delivery-" + row.ID }
					hx-swap="outerHTML"
					hx-disable="find button"
					hx-status:4xx="target:#hx-error swap:innerHTML"
					hx-status:5xx="target:#hx-error swap:innerHTML"
					class="inline"
				>
					<button type="submit" class="shrink-0 rounded-md border border-border px-2.5 py-1 text-xs font-medium text-foreground hover:bg-muted">{ d.Tr("webhooks.retry") }</button>
				</form>
			}
		</div>
		@webhookErrorBanner(d, row.Error)
		<div id={ "delivery-detail-" + row.ID }></div>
	</li>
}

templ webhookRetryAll(d web.LayoutData, v WebhookDeliveriesView) {
	<span id="webhook-retry-all">
		if v.FailedCount > 0 {
			<form
				method="post"
				action={ templ.SafeURL(webhookPath(d, v.ProjectSlug, v.EndpointID, "/retry-failed")) }
				hx-post={ webhookPath(d, v.ProjectSlug, v.EndpointID, "/retry-failed") }
				hx-nonce={ d.Nonce }
				hx-target="#webhook-deliveries"
				hx-swap="outerHTML"
				hx-disable="find button"
				hx-status:4xx="target:#hx-error swap:innerHTML"
				hx-status:5xx="target:#hx-error swap:innerHTML"
				class="inline"
			>
				<button type="submit" class="rounded-md border border-border px-3 py-1.5 text-sm font-medium text-foreground hover:bg-muted">{ d.Tr("webhooks.retry_all", "Count", v.FailedCount) }</button>
			</form>
		}
	</span>
}

// WebhookDeliveries is the HTMX-swappable deliveries section; Send test and Retry all target #webhook-deliveries.
templ WebhookDeliveries(d web.LayoutData, v WebhookDeliveriesView) {
	<div id="webhook-deliveries">
		<div class="flex flex-wrap items-center justify-between gap-3">
			<h2 class="text-sm font-semibold text-foreground">{ d.Tr("webhooks.deliveries_heading", "Count", len(v.Items)) }</h2>
			<div class="flex flex-wrap items-center gap-2">
				@webhookRetryAll(d, v)
				<form
					method="post"
					action={ templ.SafeURL(webhookPath(d, v.ProjectSlug, v.EndpointID, "/test")) }
					hx-post={ webhookPath(d, v.ProjectSlug, v.EndpointID, "/test") }
					hx-nonce={ d.Nonce }
					hx-target="#webhook-deliveries"
					hx-swap="outerHTML"
					hx-disable="find button"
					hx-status:4xx="target:#hx-error swap:innerHTML"
					hx-status:5xx="target:#hx-error swap:innerHTML"
					class="inline"
				>
					<button type="submit" disabled?={ !v.Active } class="inline-flex items-center gap-2 rounded-md bg-primary px-3 py-1.5 text-sm font-medium text-primary-foreground shadow-sm hover:bg-primary/90 disabled:opacity-50">
						@icons.Icon("send", "h-4 w-4")
						<span>{ d.Tr("webhooks.send_test") }</span>
					</button>
				</form>
			</div>
		</div>
		if v.Notice.Key != "" {
			<p data-webhook-notice class="mt-3 rounded-md border border-emerald-200 bg-emerald-50 p-3 text-sm text-emerald-800 dark:border-emerald-900/50 dark:bg-emerald-950/40 dark:text-emerald-200">{ d.Tr(v.Notice.Key, "Count", v.Notice.Count) }</p>
		}
		@webhookErrorBanner(d, v.Error)
		<ul class="mt-3 divide-y divide-border/50 overflow-hidden rounded-lg border border-border bg-card shadow-sm">
			if len(v.Items) == 0 {
				<li class="px-4 py-8 text-center text-sm text-muted-foreground">{ d.Tr("webhooks.deliveries_empty") }</li>
			}
			for _, row := range v.Items {
				@WebhookDeliveryItem(d, v, row)
			}
		</ul>
	</div>
}

// WebhookRetryResult is the row a Retry swaps in, plus the refreshed Retry-all button.
templ WebhookRetryResult(d web.LayoutData, v WebhookDeliveriesView, row WebhookDeliveryRow) {
	@WebhookDeliveryItem(d, v, row)
	<hx-partial hx-target="#webhook-retry-all" hx-swap="outerHTML" hx-nonce={ d.Nonce }>
		@webhookRetryAll(d, v)
	</hx-partial>
}

templ webhookHeaderTable(d web.LayoutData, headers []WebhookHeaderRow) {
	<div class="mt-1 overflow-x-auto">
		<table class="w-full text-left text-xs">
			<thead>
				<tr class="text-muted-foreground">
					<th scope="col" class="py-0.5 pr-3 font-medium">{ d.Tr("webhooks.header_name_label") }</th>
					<th scope="col" class="py-0.5 font-medium">{ d.Tr("webhooks.header_value_label") }</th>
				</tr>
			</thead>
			<tbody>
				for _, h := range headers {
					<tr>
						<td class="py-0.5 pr-3 align-top font-mono text-foreground">{ h.Name }</td>
						<td class="break-all py-0.5 align-top font-mono text-muted-foreground">{ h.Value }</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

templ webhookAttemptResponse(d web.LayoutData, r WebhookResponseView) {
	<details data-attempt-response class="mt-1 rounded border border-border/70 bg-background">
		<summary class="cursor-pointer px-2 py-1 text-xs font-medium text-foreground">{ d.Tr("webhooks.response_heading") }</summary>
		<div class="border-t border-border/70 p-2">
			if len(r.Headers) > 0 {
				<p class="text-xs font-semibold text-foreground">{ d.Tr("webhooks.response_headers_heading") }</p>
				@webhookHeaderTable(d, r.Headers)
			}
			<div class="mt-2 flex items-center justify-between gap-2">
				<p class="text-xs font-semibold text-foreground">{ d.Tr("webhooks.response_body_heading") }</p>
				if r.Body != "" {
					@copyButton(d, r.Body, d.Tr("webhooks.response_copy"), d.Tr("webhooks.response_copy"))
				}
			</div>
			if r.Body == "" {
				<p class="mt-1 text-xs text-muted-foreground">{ d.Tr("webhooks.response_empty") }</p>
			} else {
				<pre class="mt-1 max-h-80 overflow-auto rounded border border-border/70 bg-background p-2 font-mono text-xs text-foreground"><code>{ r.Pretty }</code></pre>
			}
			if r.Truncated {
				<p class="mt-1 text-xs text-muted-foreground">{ d.Tr("webhooks.response_truncated", "KiB", r.LimitKiB) }</p>
			}
		</div>
	</details>
}

templ webhookPayload(d web.LayoutData, p WebhookPayloadView) {
	<div data-webhook-payload class="mt-3 rounded-md border border-border/70 bg-muted/30 p-3">
		<div class="flex items-center justify-between gap-2">
			<p class="text-xs font-semibold text-foreground">{ d.Tr("webhooks.payload_heading") }</p>
			@copyButton(d, p.Body, d.Tr("webhooks.payload_copy"), d.Tr("webhooks.payload_copy"))
		</div>
		<pre class="mt-1 max-h-80 overflow-auto rounded border border-border/70 bg-background p-2 font-mono text-xs text-foreground"><code>{ p.Body }</code></pre>
		if len(p.Headers) > 0 {
			<p class="mt-3 text-xs font-semibold text-foreground">{ d.Tr("webhooks.headers_heading") }</p>
			@webhookHeaderTable(d, p.Headers)
			<p class="mt-2 text-xs text-muted-foreground">{ d.Tr("webhooks.headers_signature_note") }</p>
		}
	</div>
}

templ WebhookDeliveryDetail(d web.LayoutData, payload WebhookPayloadView, items []WebhookAttemptRow, maxAttempts int) {
	@webhookPayload(d, payload)
	<div class="mt-3 rounded-md border border-border/70 bg-muted/30 p-3">
		<p class="text-xs font-semibold text-foreground">{ d.Tr("webhooks.attempts_heading") }</p>
		if len(items) == 0 {
			<p class="mt-1 text-xs text-muted-foreground">{ d.Tr("webhooks.attempts_empty") }</p>
		}
		<ul class="mt-1 space-y-1.5">
			for i, a := range items {
				if i > 0 && items[i-1].Attempt <= a.Attempt {
					<li data-attempt-run-break class="border-t border-dashed border-border pt-1.5 text-[11px] uppercase tracking-wide text-muted-foreground/70">{ d.Tr("webhooks.attempts_earlier_run") }</li>
				}
				<li class="text-xs text-muted-foreground">
					<span class="font-medium text-foreground">{ webhookAttemptLabel(a.Attempt, maxAttempts) }</span>
					<span>·</span>
					<span>{ d.Tr("webhooks.status_code_label") }:
						if a.StatusCode > 0 {
							{ strconv.Itoa(a.StatusCode) }
						} else {
							{ d.Tr("webhooks.no_response") }
						}
					</span>
					<span>·</span>
					<span>{ a.Duration }</span>
					<span>·</span>
					<span>{ a.CreatedAt }</span>
					if a.Error != "" {
						<p class="mt-0.5 break-all font-mono text-red-700 dark:text-red-300">{ a.Error }</p>
					}
					if a.StatusCode > 0 {
						@webhookAttemptResponse(d, a.Response)
					}
				</li>
			}
		</ul>
	</div>
}

templ WebhookDetailPage(d web.LayoutData, v WebhookDetailView) {
	<section id="webhook-page">
		<header class="border-b border-border pb-4">
			<a href={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, "/webhooks")) } class="text-xs text-muted-foreground hover:underline">{ d.Tr("webhooks.back") }</a>
			<div class="mt-1 flex flex-wrap items-center gap-3">
				<h1 class="min-w-0 break-all font-mono text-xl font-semibold text-foreground">{ v.Endpoint.URL }</h1>
				@webhookActiveBadge(d, v.Endpoint.Active)
			</div>
			if v.Endpoint.Description != "" {
				<p class="mt-1 text-sm text-muted-foreground">{ v.Endpoint.Description }</p>
			}
			<p class="mt-2">
				@webhookEventBadges(d, v.Endpoint.EventLabelKeys)
			</p>
		</header>
		@webhookEphemeralBanner(d)
		if v.Secret != "" {
			@webhookSecretBanner(d, v.Secret)
		}
		<div class="mt-6 rounded-lg border border-border bg-card p-5 shadow-sm">
			<h2 class="text-sm font-semibold text-foreground">{ d.Tr("webhooks.secret_section") }</h2>
			<p class="mt-2 flex flex-wrap items-center gap-2 text-sm">
				<code class="font-mono">{ WebhookSecretMask }</code>
				if v.Endpoint.Rotating {
					<span class="rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-800 dark:bg-amber-950/60 dark:text-amber-200">{ d.Tr("webhooks.rotating") }</span>
				}
			</p>
			if v.Endpoint.Rotating {
				<p class="mt-2 text-xs text-muted-foreground">{ d.Tr("webhooks.rotating_help") }</p>
				<form method="post" action={ templ.SafeURL(webhookPath(d, v.ProjectSlug, v.Endpoint.ID, "/retire")) } class="mt-2">
					<button type="submit" class="rounded-md border border-border px-3 py-1.5 text-sm font-medium text-foreground hover:bg-muted">{ d.Tr("webhooks.retire") }</button>
				</form>
			}
			<details class="mt-3">
				<summary class="cursor-pointer text-sm font-medium text-foreground">{ d.Tr("webhooks.rotate") }</summary>
				<p class="mt-2 text-xs text-muted-foreground">{ d.Tr("webhooks.rotate_warning") }</p>
				if v.Endpoint.Rotating {
					<p class="mt-1 text-xs text-amber-800 dark:text-amber-200">{ d.Tr("webhooks.rotate_replaces_secondary") }</p>
				}
				<form
					method="post"
					action={ templ.SafeURL(webhookPath(d, v.ProjectSlug, v.Endpoint.ID, "/rotate")) }
					hx-post={ webhookPath(d, v.ProjectSlug, v.Endpoint.ID, "/rotate") }
					hx-nonce={ d.Nonce }
					hx-target="#webhook-page"
					hx-swap="outerHTML"
					hx-disable="find button"
					hx-status:4xx="target:#hx-error swap:innerHTML"
					hx-status:5xx="target:#hx-error swap:innerHTML"
					class="mt-2"
				>
					<button type="submit" class="rounded-md bg-amber-600 px-3 py-1.5 text-sm font-medium text-white shadow-sm hover:bg-amber-700">{ d.Tr("webhooks.rotate_confirm") }</button>
				</form>
			</details>
		</div>
		@WebhookVerifyPanel(d, v.Guide)
		<div class="mt-6">
			<h2 class="mb-2 text-sm font-semibold text-foreground">{ d.Tr("webhooks.settings_section") }</h2>
			@webhookForm(d, v.Form)
		</div>
		<div class="mt-6">
			@WebhookDeliveries(d, v.Deliveries)
		</div>
		@copyScript(d.Nonce)
		<details class="mt-6 rounded-lg border border-red-200 p-5 dark:border-red-900/50">
			<summary class="cursor-pointer text-sm font-medium text-red-700 dark:text-red-300">{ d.Tr("webhooks.delete") }</summary>
			<p class="mt-2 text-xs text-muted-foreground">{ d.Tr("webhooks.delete_warning") }</p>
			<form method="post" action={ templ.SafeURL(webhookPath(d, v.ProjectSlug, v.Endpoint.ID, "/delete")) } class="mt-2">
				<button type="submit" class="inline-flex items-center gap-2 rounded-md bg-red-600 px-3 py-1.5 text-sm font-medium text-white shadow-sm hover:bg-red-700">
					@icons.Icon("trash-2", "h-4 w-4")
					<span>{ d.Tr("webhooks.delete_confirm") }</span>
				</button>
			</form>
		</details>
	</section>
}

templ WebhookDetailLayout(d web.LayoutData, v WebhookDetailView) {
	@Layout(web.WithContent(d, WebhookDetailPage(d, v)))
}
