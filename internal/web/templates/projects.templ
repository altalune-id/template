package templates

import (
	"altalune.id/template/internal/web"
	"altalune.id/template/internal/web/icons"
)

type ProjectsView struct {
	OrgSlug  string
	Projects []ProjectSummary
	Error    string
}

templ ProjectsPage(d web.LayoutData, v ProjectsView) {
	<section>
		<header class="flex items-baseline justify-between border-b border-border pb-4">
			<div>
				<h1 class="text-2xl font-semibold text-foreground">{ d.Tr("projects.title") }</h1>
				<p class="mt-1 text-sm text-muted-foreground">{ d.Tr("projects.subtitle") }</p>
			</div>
			<a href={ templ.SafeURL(d.Href("/projects/new")) } class="inline-flex items-center gap-2 rounded-md bg-primary px-3 py-1.5 text-sm font-medium text-primary-foreground shadow-sm hover:bg-primary/90">
				@icons.Icon("plus", "h-4 w-4")
				<span>{ d.Tr("nav.new_project") }</span>
			</a>
		</header>
		if v.Error != "" {
			<div class="mt-4 rounded-md border border-red-200 bg-red-50 p-3 text-sm text-red-800 dark:border-red-900/50 dark:bg-red-950/40 dark:text-red-200">{ v.Error }</div>
		}
		if len(v.Projects) == 0 {
			<div class="mt-6 rounded-lg border border-dashed border-border bg-card p-8 text-center">
				<p class="text-sm text-muted-foreground">{ d.Tr("projects.empty") }</p>
				<a href={ templ.SafeURL(d.Href("/projects/new")) } class="mt-4 inline-block rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow-sm hover:bg-primary/90">{ d.Tr("projects.create_first") }</a>
			</div>
		} else {
			<ul class="mt-6 divide-y divide-border/50 overflow-hidden rounded-lg border border-border bg-card shadow-sm">
				for _, p := range v.Projects {
					<li class="flex items-center justify-between px-4 py-3">
						<div class="min-w-0">
							<p class="flex items-center gap-2 truncate text-sm font-medium text-foreground">
								<span class="truncate">{ p.Name }</span>
								if p.System {
									<span class="inline-flex items-center rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-800 ring-1 ring-inset ring-amber-200 dark:bg-amber-500/15 dark:text-amber-300 dark:ring-amber-500/25">{ d.Tr("common.system") }</span>
								}
							</p>
							<p class="truncate text-xs text-muted-foreground">{ p.Slug }</p>
						</div>
						<a href={ templ.SafeURL(d.Href("/projects/" + p.Slug + "/overview")) } class="ml-4 text-sm font-medium text-muted-foreground hover:text-foreground">{ d.Tr("common.open") }</a>
					</li>
				}
			</ul>
		}
	</section>
}

templ ProjectsLayout(d web.LayoutData, v ProjectsView) {
	@Layout(web.WithContent(d, ProjectsPage(d, v)))
}
