package templates

import (
	"fmt"

	"altalune.id/template/internal/web"
)

type OverviewView struct {
	OrgSlug string
	ProjectID   string
	ProjectSlug string
	ProjectName string
	TotalTodos  int
	OpenTodos   int
	DoneTodos   int
}

templ OverviewPage(d web.LayoutData, v OverviewView) {
	<section class="flex flex-col gap-6">
		<header class="border-b border-border pb-4">
			<p class="text-xs font-semibold uppercase tracking-wide text-muted-foreground/70">{ d.Tr("nav.overview") }</p>
			<h1 class="mt-1 text-2xl font-semibold text-foreground">{ v.ProjectName }</h1>
			<div class="mt-2 flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
				@copyValue(d, v.OrgSlug)
				<span aria-hidden="true" class="text-muted-foreground/70">/</span>
				@copyValue(d, v.ProjectSlug)
				<span aria-hidden="true" class="text-muted-foreground/70">·</span>
				@copyValue(d, v.ProjectID)
			</div>
			@copyScript(d.Nonce)
		</header>
		<div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
			@statCard(d.Tr("nav.todos"), fmt.Sprintf("%d", v.TotalTodos))
			@statCard(d.Tr("overview.stat_open"), fmt.Sprintf("%d", v.OpenTodos))
			@statCard(d.Tr("overview.stat_done"), fmt.Sprintf("%d", v.DoneTodos))
		</div>
		<div class="rounded-lg border border-border bg-card p-6 shadow-sm">
			<h2 class="text-sm font-semibold text-foreground">{ d.Tr("overview.quick_actions") }</h2>
			<div class="mt-4 flex flex-wrap gap-2">
				<a
					href={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, "/todos")) }
					class="inline-flex items-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow-sm hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
				>
					{ d.Tr("overview.open_todos") }
				</a>
				<a
					href={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, "/posts")) }
					class="inline-flex items-center rounded-md border border-border px-4 py-2 text-sm font-medium text-foreground/90 shadow-sm hover:bg-muted focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
				>
					{ d.Tr("overview.open_posts") }
				</a>
			</div>
		</div>
	</section>
}

templ copyValue(d web.LayoutData, value string) {
	<button
		type="button"
		data-copy={ value }
		data-copy-label={ d.Tr("common.copy") + ": " + value }
		data-copied-label={ d.Tr("common.copied") }
		aria-label={ d.Tr("common.copy") + ": " + value }
		class="rounded-md font-mono text-xs text-muted-foreground hover:text-foreground focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-1"
	>{ value }</button>
}

templ copyScript(nonce string) {
	<script nonce={ nonce }>
	if (!window.altemplCopyBound) {
	window.altemplCopyBound = true;
	document.addEventListener('click', function(e) {
		if (!e.target || !e.target.closest) return;
		var btn = e.target.closest('[data-copy]');
		if (!btn) return;
		var text = btn.getAttribute('data-copy');
		var done = function() {
			btn.textContent = btn.getAttribute('data-copied-label');
			btn.setAttribute('aria-label', btn.getAttribute('data-copied-label'));
			setTimeout(function() {
				btn.textContent = text;
				btn.setAttribute('aria-label', btn.getAttribute('data-copy-label'));
			}, 1500);
		};
		if (navigator.clipboard && navigator.clipboard.writeText) {
			navigator.clipboard.writeText(text).then(done, function() {});
			return;
		}
		var ta = document.createElement('textarea');
		ta.value = text;
		ta.setAttribute('readonly', '');
		ta.style.position = 'fixed';
		ta.style.opacity = '0';
		document.body.appendChild(ta);
		ta.select();
		try { document.execCommand('copy'); done(); } catch (err) {}
		document.body.removeChild(ta);
	});
	}
	</script>
}

templ statCard(label, value string) {
	<div class="rounded-lg border border-border bg-card p-4 shadow-sm">
		<p class="text-xs font-semibold uppercase tracking-wide text-muted-foreground/70">{ label }</p>
		<p class="mt-2 text-2xl font-semibold text-foreground">{ value }</p>
	</div>
}

templ OverviewLayout(d web.LayoutData, v OverviewView) {
	@Layout(web.WithContent(d, OverviewPage(d, v)))
}
