package templates

import (
	"altalune.id/template/internal/web"
	"altalune.id/template/internal/web/icons"
)

type TodosView struct {
	ProjectID   string
	ProjectSlug string
	ProjectName string
	Items       []TodoRow
	Error       string
}

// TodoList is the HTMX-swappable list section — POST to /todos targets #todo-list.
templ TodoList(d web.LayoutData, items []TodoRow) {
	<ul id="todo-list" class="mt-6 divide-y divide-border/50 rounded-lg border border-border bg-card shadow-sm">
		if len(items) == 0 {
			<li class="px-4 py-8 text-center text-sm text-muted-foreground">{ d.Tr("todos.empty") }</li>
		}
		for _, t := range items {
			@TodoRowFragment(d, t)
		}
	</ul>
}

templ TodosPage(d web.LayoutData, v TodosView) {
	<section>
		<header class="flex items-baseline justify-between border-b border-border pb-4">
			<div>
				<h1 class="text-2xl font-semibold text-foreground">{ d.Tr("nav.todos") }</h1>
				<p class="mt-1 text-sm text-muted-foreground">{ v.ProjectName }</p>
			</div>
			<form
				method="post"
				action={ templ.SafeURL(d.Href("/projects/" + v.ProjectSlug + "/todos/clear")) }
				hx-post={ d.Href("/projects/" + v.ProjectSlug + "/todos/clear") }
				hx-target="#todo-list"
				hx-swap="outerHTML"
				class="inline"
			>
				<button type="submit" class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground">
					@icons.Icon("trash-2", "h-4 w-4")
					<span>{ d.Tr("todos.clear_completed") }</span>
				</button>
			</form>
		</header>
		if v.Error != "" {
			<div class="mt-4 rounded-md border border-red-200 bg-red-50 p-3 text-sm text-red-800 dark:border-red-900/50 dark:bg-red-950/40 dark:text-red-200">{ v.Error }</div>
		}
		<form
			method="post"
			action={ templ.SafeURL(d.Href("/projects/" + v.ProjectSlug + "/todos")) }
			hx-post={ d.Href("/projects/" + v.ProjectSlug + "/todos") }
			hx-target="#todo-list"
			hx-swap="outerHTML"
			hx-on::after-request="if(event.detail.successful) this.reset()"
			class="mt-6 flex gap-2"
		>
			<input
				name="title"
				type="text"
				required
				placeholder={ d.Tr("todos.placeholder") }
				class="flex-1 rounded-md border border-border bg-card px-3 py-2 text-sm text-foreground placeholder:text-muted-foreground/70 shadow-sm focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-1"
			/>
			<button type="submit" class="rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow-sm hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2">
				{ d.Tr("todos.add") }
			</button>
		</form>
		@TodoList(d, v.Items)
	</section>
}

templ TodosLayout(d web.LayoutData, v TodosView) {
	@Layout(web.WithContent(d, TodosPage(d, v)))
}
