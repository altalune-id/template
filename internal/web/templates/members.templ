package templates

import (
	"altalune.id/template/internal/web"
	"altalune.id/template/internal/web/icons"
)

type MemberRow struct {
	UserID string
	Email  string
	Name   string
	Role   string
	System bool
}

type MembersView struct {
	OrgSlug   string
	Members   []MemberRow
	CanManage bool
	Error     string
}

templ MembersPage(d web.LayoutData, v MembersView) {
	<section>
		<header class="flex items-baseline justify-between border-b border-border pb-4">
			<div>
				<h1 class="text-2xl font-semibold text-foreground">{ d.Tr("members.title") }</h1>
				<p class="mt-1 text-sm text-muted-foreground">{ d.Tr("members.subtitle") }</p>
			</div>
			if v.CanManage {
				<a href={ templ.SafeURL(d.Href("/orgs/" + v.OrgSlug + "/invites")) } class="inline-flex items-center gap-2 rounded-md bg-primary px-3 py-1.5 text-sm font-medium text-primary-foreground shadow-sm hover:bg-primary/90">
					@icons.Icon("user-plus", "h-4 w-4")
					<span>{ d.Tr("members.invite_button") }</span>
				</a>
			}
		</header>
		if v.Error != "" {
			<div class="mt-4 rounded-md border border-red-200 bg-red-50 p-3 text-sm text-red-800 dark:border-red-900/50 dark:bg-red-950/40 dark:text-red-200">{ v.Error }</div>
		}
		<ul class="mt-6 divide-y divide-border/50 overflow-hidden rounded-lg border border-border bg-card shadow-sm">
			if len(v.Members) == 0 {
				<li class="px-4 py-6 text-center text-sm text-muted-foreground">{ d.Tr("members.empty") }</li>
			}
			for _, m := range v.Members {
				<li class="flex items-center justify-between px-4 py-3">
					<div class="min-w-0">
						<p class="truncate text-sm font-medium text-foreground">
							if m.Name != "" {
								{ m.Name }
							} else {
								{ m.Email }
							}
						</p>
						<p class="truncate text-xs text-muted-foreground">
							{ m.Email } · { m.Role }
							if m.System {
								<span class="ml-2 inline-flex items-center rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-800 ring-1 ring-inset ring-amber-200 dark:bg-amber-500/15 dark:text-amber-300 dark:ring-amber-500/25">{ d.Tr("common.system") }</span>
							}
						</p>
					</div>
					if v.CanManage && !m.System {
						<form method="post" action={ templ.SafeURL(d.Href("/orgs/" + v.OrgSlug + "/members/" + m.UserID + "/remove")) } class="ml-4 inline">
							<button type="submit" aria-label={ "Remove " + m.Email } class="rounded p-1.5 text-muted-foreground/70 hover:bg-red-50 hover:text-red-600 dark:hover:bg-red-950/40 dark:hover:text-red-400">
								@icons.Icon("trash-2", "h-4 w-4")
							</button>
						</form>
					}
				</li>
			}
		</ul>
	</section>
}

templ MembersLayout(d web.LayoutData, v MembersView) {
	@Layout(web.WithContent(d, MembersPage(d, v)))
}
