package templates

import (
	"altalune.id/template/internal/web"
	"altalune.id/template/internal/web/icons"
)

type InviteRow struct {
	ID        string
	Email     string
	Role      string
	ExpiresAt string
}

type InvitesView struct {
	OrgSlug   string
	Invites   []InviteRow
	CanManage bool
	Disabled  bool
	Error     string
}

templ InvitesPage(d web.LayoutData, v InvitesView) {
	<section>
		<header class="border-b border-border pb-4">
			<h1 class="text-2xl font-semibold text-foreground">{ d.Tr("invites.title") }</h1>
			<p class="mt-1 text-sm text-muted-foreground">{ d.Tr("invites.subtitle") }</p>
		</header>
		if v.Disabled {
			<div class="mt-4 rounded-md border border-amber-200 bg-amber-50 p-3 text-sm text-amber-900 dark:border-amber-900/50 dark:bg-amber-950/40 dark:text-amber-200">{ d.Tr("invites.disabled_banner") }</div>
		}
		if v.Error != "" {
			<div class="mt-4 rounded-md border border-red-200 bg-red-50 p-3 text-sm text-red-800 dark:border-red-900/50 dark:bg-red-950/40 dark:text-red-200">{ v.Error }</div>
		}
		<ul class="mt-6 divide-y divide-border/50 overflow-hidden rounded-lg border border-border bg-card shadow-sm">
			if len(v.Invites) == 0 {
				<li class="px-4 py-6 text-center text-sm text-muted-foreground">{ d.Tr("invites.empty") }</li>
			}
			for _, i := range v.Invites {
				<li class="flex items-center justify-between px-4 py-3">
					<div class="min-w-0">
						<p class="truncate text-sm font-medium text-foreground">{ i.Email }</p>
						<p class="truncate text-xs text-muted-foreground">{ i.Role } · expires { i.ExpiresAt }</p>
					</div>
					if v.CanManage {
						<form method="post" action={ templ.SafeURL(d.Href("/orgs/" + v.OrgSlug + "/invites/" + i.ID + "/revoke")) } class="ml-4 inline">
							<button type="submit" aria-label={ "Revoke invite for " + i.Email } class="rounded p-1.5 text-muted-foreground/70 hover:bg-red-50 hover:text-red-600 dark:hover:bg-red-950/40 dark:hover:text-red-400">
								@icons.Icon("trash-2", "h-4 w-4")
							</button>
						</form>
					}
				</li>
			}
		</ul>
		if v.CanManage && !v.Disabled {
			<form method="post" action={ templ.SafeURL(d.Href("/orgs/" + v.OrgSlug + "/invites")) } class="mt-8 space-y-5 rounded-lg border border-border bg-card p-5 shadow-sm">
				<div>
					<h2 class="text-sm font-semibold text-foreground">{ d.Tr("invites.form_heading") }</h2>
					<p class="mt-1 text-xs text-muted-foreground">{ d.Tr("invites.form_subtitle") }</p>
				</div>
				<div>
					<label class="block text-sm font-medium text-foreground/90" for="invite-email">{ d.Tr("invites.form_email") }</label>
					<input id="invite-email" name="email" type="email" required class="mt-1.5 block w-full rounded-md border border-border bg-card px-3 py-2 text-sm text-foreground placeholder:text-muted-foreground/70 shadow-sm focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-1"/>
				</div>
				<div>
					<label class="block text-sm font-medium text-foreground/90" for="invite-role">{ d.Tr("invites.form_role") }</label>
					<select id="invite-role" name="role" required class="mt-1.5 block w-full rounded-md border border-border bg-card px-3 py-2 text-sm text-foreground shadow-sm focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-1">
						<option value="member">{ d.Tr("invites.role_member") }</option>
						<option value="admin">{ d.Tr("invites.role_admin") }</option>
					</select>
				</div>
				<button type="submit" class="inline-flex items-center gap-2 rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow-sm hover:bg-primary/90">
					@icons.Icon("send", "h-4 w-4")
					<span>{ d.Tr("invites.submit") }</span>
				</button>
			</form>
		}
	</section>
}

templ InvitesLayout(d web.LayoutData, v InvitesView) {
	@Layout(web.WithContent(d, InvitesPage(d, v)))
}
