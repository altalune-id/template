package templates

import "altalune.id/template/internal/web"

// ErrorBanner renders an inline form error together with the request id, so a user report maps to a log line.
templ ErrorBanner(d web.LayoutData, msg string) {
	<div class="mt-4 rounded-md border border-red-200 bg-red-50 p-3 text-sm text-red-800 dark:border-red-900/50 dark:bg-red-950/40 dark:text-red-200">
		<p>{ msg }</p>
		if d.RequestID != "" {
			<p class="mt-1.5 text-xs text-red-800/80 dark:text-red-200/70">
				{ d.Tr("error.request_id") }
				<code class="select-all font-mono">{ d.RequestID }</code>
			</p>
		}
	</div>
}
