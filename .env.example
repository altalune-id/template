# altempl — auto-generated from internal/platform/config struct tags.
# DO NOT edit by hand. Run `go tool gen-config-example` to regenerate.
#
# Awareness markers on each field (in [brackets] above the env var):
#   required   — must be non-empty for the app to boot (in the applicable mode)
#   bootstrap  — set once at first-run; changing later has no effect or breaks things
#   secret     — never commit; use env vars or a secret store
#   mode:X     — only applies in the given mode (selfhosted | cloud)
#
# Fields split into two top-level sections:
#   BOOTSTRAP — locked at first boot, changing later is NOT SAFE
#   RUNTIME   — safe to change via env + restart
#
# RHS shows the built-in default when present. Secret fields intentionally
# emit no RHS value, even if a default exists internally.


# ════════════════════════════════════════════════════════════════════
#   BOOTSTRAP — set once at first boot; changing later is NOT SAFE
# ════════════════════════════════════════════════════════════════════
#
# Fields in this section lock in behavior for the lifetime of the deployment:
#   - Changing them via env vars after first boot has NO effect on already-
#     persisted data (e.g., db.driver is set at first migration; switching
#     from sqlite→postgres requires a full data migration, not an env flip).
#   - Some fields are secrets used to sign existing tokens/cookies
#     (http.stateSecret) — rotating invalidates in-flight sessions.
#   - Some fields are database-layer decisions (schema, tablePrefix) that
#     require SQL-level intervention to change.
#
# Read every line here BEFORE first `altempl serve`. Set them deliberately.
#
# ────────────────────────────────────────────────────────────────────

# ─── db ───
# [required, bootstrap] db.driver
ALT_DB_DRIVER=sqlite
# [bootstrap] db.schema
ALT_DB_SCHEMA=
# [bootstrap] db.tablePrefix
ALT_DB_TABLE_PREFIX=altempl_
# [bootstrap] db.role
ALT_DB_ROLE=
# [secret, bootstrap] db.migrator.dsn
ALT_DB_MIGRATOR_DSN=
# [bootstrap] db.migrator.role
ALT_DB_MIGRATOR_ROLE=
# [bootstrap] db.reader.role
ALT_DB_READER_ROLE=
# [secret, bootstrap] db.maintenance.dsn
ALT_DB_MAINTENANCE_DSN=
# [bootstrap] db.maintenance.role
ALT_DB_MAINTENANCE_ROLE=
# [bootstrap] db.allowBypassRLS
ALT_DB_ALLOW_BYPASS_RLS=

# ─── genesis ───
# [bootstrap] genesis.email
ALT_GENESIS_EMAIL=
# [bootstrap, secret] genesis.password
ALT_GENESIS_PASSWORD=

# ── cloud only ──
# [bootstrap, mode:cloud] genesis.breakGlass
ALT_GENESIS_BREAK_GLASS=false

# ─── http ───
# [required, secret, bootstrap] http.stateSecret
ALT_HTTP_STATE_SECRET=

# ─── i18n ───
# [required, bootstrap] i18n.defaultLocale
ALT_I18N_DEFAULT_LOCALE=en-US

# ─── log ───
# [bootstrap] log.redactPatterns
ALT_LOG_REDACT_PATTERNS=

# ─── mode ───
# [required, bootstrap] mode
ALT_MODE=selfhosted

# ─── scheduler ───
# [bootstrap] scheduler.enabled
ALT_SCHEDULER_ENABLED=true
# [bootstrap] scheduler.timezone
ALT_SCHEDULER_TIMEZONE=UTC

# ─── tenant ───
# [bootstrap] tenant.rlsEnforce
ALT_TENANT_RLS_ENFORCE=true
# [bootstrap] tenant.singletonOrg.slug
ALT_TENANT_SINGLETON_ORG_SLUG=default
# [bootstrap] tenant.singletonOrg.name
ALT_TENANT_SINGLETON_ORG_NAME=Default Organization
# [bootstrap] tenant.tenantScopedTables
ALT_TENANT_TENANT_SCOPED_TABLES=

# ─── tokens ───

# ── cloud only ──
# [required, mode:cloud, bootstrap] tokens.audience
ALT_TOKENS_AUDIENCE=urn:altempl:api


# ════════════════════════════════════════════════════════════════════
#   RUNTIME — safe to change via env + restart
# ════════════════════════════════════════════════════════════════════
#
# Fields in this section can be adjusted between deployments without
# affecting persisted data. Restarting the app picks up the new values.
#
# ────────────────────────────────────────────────────────────────────

# ─── api ───
# api.enabled
ALT_API_ENABLED=true
# api.openapi.enabled
ALT_API_OPENAPI_ENABLED=true
# api.openapi.requireBasicAuth
ALT_API_OPENAPI_REQUIRE_BASIC_AUTH=true
# api.openapi.basicAuthUser
ALT_API_OPENAPI_BASIC_AUTH_USER=
# [secret] api.openapi.basicAuthPassword
ALT_API_OPENAPI_BASIC_AUTH_PASSWORD=

# ─── compliance ───
# compliance.termsURL
ALT_COMPLIANCE_TERMS_URL=
# compliance.privacyURL
ALT_COMPLIANCE_PRIVACY_URL=
# compliance.requireAcceptance
ALT_COMPLIANCE_REQUIRE_ACCEPTANCE=

# ─── db ───
# [required, secret] db.dsn
ALT_DB_DSN=
# [secret] db.reader.dsn
ALT_DB_READER_DSN=
# db.reader.maxOpenConns
ALT_DB_READER_MAX_OPEN_CONNS=
# db.reader.maxIdleConns
ALT_DB_READER_MAX_IDLE_CONNS=
# db.reader.connMaxLifetime
ALT_DB_READER_CONN_MAX_LIFETIME=
# db.reader.connMaxIdleTime
ALT_DB_READER_CONN_MAX_IDLE_TIME=
# db.maintenance.maxOpenConns
ALT_DB_MAINTENANCE_MAX_OPEN_CONNS=2
# db.maintenance.maxIdleConns
ALT_DB_MAINTENANCE_MAX_IDLE_CONNS=
# db.maintenance.connMaxLifetime
ALT_DB_MAINTENANCE_CONN_MAX_LIFETIME=
# db.maintenance.connMaxIdleTime
ALT_DB_MAINTENANCE_CONN_MAX_IDLE_TIME=
# db.health.interval
ALT_DB_HEALTH_INTERVAL=30s
# db.health.timeout
ALT_DB_HEALTH_TIMEOUT=2s
# db.autoMigrate
ALT_DB_AUTO_MIGRATE=true
# db.maxOpenConns
ALT_DB_MAX_OPEN_CONNS=
# db.maxIdleConns
ALT_DB_MAX_IDLE_CONNS=
# db.connMaxLifetime
ALT_DB_CONN_MAX_LIFETIME=
# db.connMaxIdleTime
ALT_DB_CONN_MAX_IDLE_TIME=
# db.connectTimeout
ALT_DB_CONNECT_TIMEOUT=30s
# db.connectBackoff
ALT_DB_CONNECT_BACKOFF=250ms

# ─── http ───
# [required] http.addr
ALT_HTTP_ADDR=:5150
# http.basePath
ALT_HTTP_BASE_PATH=
# [required] http.baseURL
ALT_HTTP_BASE_URL=
# http.cookieSecure
ALT_HTTP_COOKIE_SECURE=false
# http.robotsTxt
ALT_HTTP_ROBOTS_TXT=

# ─── log ───
# log.level
ALT_LOG_LEVEL=info
# log.format
ALT_LOG_FORMAT=json
# log.addSource
ALT_LOG_ADD_SOURCE=

# ─── mail ───
# mail.driver
ALT_MAIL_DRIVER=console
# mail.from
ALT_MAIL_FROM=no-reply@altempl.local
# mail.smtp.host
ALT_MAIL_SMTP_HOST=
# mail.smtp.port
ALT_MAIL_SMTP_PORT=587
# mail.smtp.user
ALT_MAIL_SMTP_USER=
# [secret] mail.smtp.pass
ALT_MAIL_SMTP_PASS=
# mail.smtp.tls
ALT_MAIL_SMTP_TLS=true

# ─── observability ───
# observability.reporter.minSeverity
ALT_OBSERVABILITY_REPORTER_MIN_SEVERITY=error
# observability.reporter.sinks
ALT_OBSERVABILITY_REPORTER_SINKS=

# ─── oidc ───
# oidc.resource
ALT_OIDC_RESOURCE=
# oidc.scopes
ALT_OIDC_SCOPES=openid,email,profile
# oidc.redirectPort
ALT_OIDC_REDIRECT_PORT=
# oidc.buttonLabel
ALT_OIDC_BUTTON_LABEL=
# oidc.buttonLogoURL
ALT_OIDC_BUTTON_LOGO_URL=
# oidc.endSessionOnLogout
ALT_OIDC_END_SESSION_ON_LOGOUT=

# ── cloud only ──
# [required, mode:cloud] oidc.issuer
ALT_OIDC_ISSUER=
# [required, mode:cloud] oidc.clientID
ALT_OIDC_CLIENT_ID=
# [required, mode:cloud, secret] oidc.clientSecret
ALT_OIDC_CLIENT_SECRET=

# ─── scheduler ───
# scheduler.shutdownGrace
ALT_SCHEDULER_SHUTDOWN_GRACE=30s

# ─── session ───
# session.path
ALT_SESSION_PATH=~/.altempl/session.json

# ─── telemetry ───
# telemetry.otlp.endpoint
ALT_TELEMETRY_OTLP_ENDPOINT=
# telemetry.otlp.protocol
ALT_TELEMETRY_OTLP_PROTOCOL=
# telemetry.otlp.insecure
ALT_TELEMETRY_OTLP_INSECURE=
# [secret] telemetry.otlp.headers
ALT_TELEMETRY_OTLP_HEADERS=
# telemetry.tracing.enabled
ALT_TELEMETRY_TRACING_ENABLED=false
# telemetry.tracing.sampleRatio
ALT_TELEMETRY_TRACING_SAMPLE_RATIO=
# telemetry.metrics.enabled
ALT_TELEMETRY_METRICS_ENABLED=false
# telemetry.metrics.exportInterval
ALT_TELEMETRY_METRICS_EXPORT_INTERVAL=30s
# telemetry.metrics.prometheus.enabled
ALT_TELEMETRY_METRICS_PROMETHEUS_ENABLED=false
# telemetry.metrics.prometheus.addr
ALT_TELEMETRY_METRICS_PROMETHEUS_ADDR=:9091
# telemetry.metrics.prometheus.path
ALT_TELEMETRY_METRICS_PROMETHEUS_PATH=/metrics

# ─── tenant ───
# tenant.personalOrgSlugFallback
ALT_TENANT_PERSONAL_ORG_SLUG_FALLBACK=personal
# tenant.personalProjectSlug
ALT_TENANT_PERSONAL_PROJECT_SLUG=default

# ─── tokens ───
# tokens.jwksCacheTTL
ALT_TOKENS_JWKS_CACHE_TTL=
# tokens.clockSkew
ALT_TOKENS_CLOCK_SKEW=60s
# tokens.supportedAlgs
ALT_TOKENS_SUPPORTED_ALGS=RS256,ES256
# tokens.acceptRS256
ALT_TOKENS_ACCEPT_RS256=

# ── cloud only ──
# [required, mode:cloud] tokens.issuer
ALT_TOKENS_ISSUER=
# [required, mode:cloud] tokens.jwksURL
ALT_TOKENS_JWKS_URL=
