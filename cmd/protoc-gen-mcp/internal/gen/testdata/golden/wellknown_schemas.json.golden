{
  "absorb_well_known": {
    "type": "object",
    "properties": {
      "at": {
        "type": "string",
        "format": "date-time"
      },
      "howLong": {
        "type": "string",
        "pattern": "^-?[0-9]+(\\.[0-9]{1,9})?s$"
      },
      "mask": {
        "type": "string"
      },
      "ratio": {
        "type": "number"
      },
      "smallRatio": {
        "type": "number"
      },
      "count": {
        "type": "integer"
      },
      "unsignedCount": {
        "type": "integer",
        "minimum": 0
      },
      "big": {
        "type": "string",
        "pattern": "^-?[0-9]+$"
      },
      "bigUnsigned": {
        "type": "string",
        "pattern": "^[0-9]+$"
      },
      "loud": {
        "type": "boolean"
      },
      "label": {
        "type": "string"
      },
      "blob": {
        "type": "string",
        "format": "byte"
      },
      "payload": {
        "type": "object"
      },
      "anything": {},
      "items": {
        "type": "array"
      },
      "boxed": {
        "type": "object",
        "properties": {
          "@type": {
            "type": "string"
          }
        },
        "required": [
          "@type"
        ]
      },
      "rawUnsigned": {
        "type": "string",
        "pattern": "^[0-9]+$"
      },
      "rawSmallUnsigned": {
        "type": "integer",
        "minimum": 0
      },
      "windows": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]{1,9})?s$"
        }
      },
      "attributes": {
        "type": "object",
        "additionalProperties": {}
      }
    },
    "required": [
      "at",
      "bigUnsigned"
    ],
    "additionalProperties": false
  }
}
